# =============================================================================
# Team Platform — Website environment
# NEXT_PUBLIC_* values are inlined at build time: rebuild after changing them.
# =============================================================================

# Public URL of the backend API (used by the contact form in the browser and to allow images)
NEXT_PUBLIC_API_URL=https://api.example.com

# Public URL of this website (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Optional ------------------------------------------------------------------

# Private URL for server-side API calls when the website and API share a network
# (e.g. same VPS). Falls back to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://127.0.0.1:4000

# Shared secret for POST /api/revalidate (same value as REVALIDATE_SECRET in the backend).
# Lets Admin changes appear on the website immediately. At least 32 characters.
REVALIDATE_SECRET=

# Safety-net cache lifetime for API content, in seconds (default 3600).
# CONTENT_REVALIDATE_SECONDS=3600

# Extra image origins allowed for optimization (e.g. a CDN), comma-separated.
# NEXT_PUBLIC_IMAGE_ORIGINS=https://cdn.example.com

# Site name used only if the API is unreachable during the build.
# NEXT_PUBLIC_SITE_NAME=

# Set to false on staging to block search engines (robots + noindex).
# NEXT_PUBLIC_ALLOW_INDEXING=true

# Allow optimizing images from localhost/private IPs in production (only on private networks).
# IMAGES_ALLOW_LOCAL_IP=false
